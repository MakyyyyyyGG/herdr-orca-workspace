{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.16"
  },
  "type": "column",
  "children": [
    {
      "id": "workspace",
      "type": "row",
      "divider": {
        "width": 1,
        "color": "border"
      },
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "children": [
            {
              "id": "brand",
              "type": "block",
              "content": {
                "mod": "workspace-chrome"
              },
              "size": {
                "px": 46
              },
              "window_drag": true
            },
            {
              "id": "projects",
              "type": "block",
              "min": 60,
              "content": {
                "mod": "orca-projects"
              }
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "content": {
                "mod": "workspace-chrome",
                "props": {
                  "footer": true
                }
              },
              "size": {
                "px": 69
              }
            }
          ],
          "size": {
            "px": 284
          },
          "min": 44,
          "max": 480,
          "background": "chrome",
          "resizable": false
        },
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "orca-tabs"
              },
              "size": {
                "px": 42
              },
              "window_drag": true
            },
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "#5e8e88"
                      },
                      "radius": 8,
                      "gap": 8,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "inspector-header",
                      "type": "block",
                      "size": {
                        "px": 96
                      },
                      "content": {
                        "mod": "orca-inspector"
                      }
                    },
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "orca-files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "orca-changes"
                          }
                        }
                      ],
                      "active": "files"
                    }
                  ],
                  "size": {
                    "px": 368
                  },
                  "min": 280,
                  "max": 900,
                  "hidden": false,
                  "background": "chrome",
                  "radius": 9,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "resizable": false
                }
              ],
              "padding": 6,
              "gap": 6
            }
          ],
          "resizable": false
        }
      ]
    },
    {
      "id": "usage",
      "type": "block",
      "size": {
        "px": 30
      },
      "content": {
        "mod": "orca-usage"
      }
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "resizable": false,
  "theme": "graphite",
  "colors": {
    "chrome": "#202831",
    "background": "#161c22",
    "canvas": "#12171d",
    "surface": "#2c3641",
    "raised": "#2c3842",
    "selected": "#354650",
    "hover": "#34414c",
    "border": "#38434c",
    "input": "#46535f",
    "foreground": "#e9eef2",
    "muted": "#b9c6ce",
    "dim": "#9aaab6",
    "accent": "#8bd9c7",
    "working": "#78d7bb",
    "blocked": "#efbd85",
    "idle": "#84939e",
    "done": "#9ac5e8",
    "popover": "#242e38",
    "solid": "#8bd9c7",
    "solid_foreground": "#152822"
  },
  "preview": "layouts/orca.svg",
  "ui_font": "Segoe UI"
}
